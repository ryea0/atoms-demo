LLM_PROVIDER=mock            # mock | openai
LLM_BASE_URL=                # OpenAI 兼容地址
LLM_API_KEY=
LLM_MODEL=                   # 默认模型
LLM_MODEL_LEADER=            # 可选角色覆盖
LLM_MODEL_ENGINEER=
LLM_MOCK_DELAY_MS=5          # mock 流式 chunk 间隔（毫秒；测试/离线置 0）
LLM_TIMEOUT_MS=90000         # 非流式（complete）总时长上限（毫秒，正整数；非法值回退默认）
LLM_STREAM_IDLE_TIMEOUT_MS=45000   # 流式空闲超时：连续无 chunk 超过该阈值才判死（每收到数据即重置；须大于 provider 实测最大 chunk 间隙）
LLM_STREAM_TOTAL_TIMEOUT_MS=300000 # 流式总时长上限：长文健康流也会跑满数分钟，仅作兜底防无限占用
DB_DRIVER=sqlite
DB_FILE=data/app.db
RETRIEVAL_PROVIDER=grep      # grep（默认，RegExp 扫文件）| fts5（同库 FTS5 虚表 trigram/bm25）；非法值回退 grep
EXEC_PROVIDER=local          # local（默认，受控宿主执行：终端面板 + engineer bash 自检）| disabled（全关）；非法值回退 local。仅限本机/内网演示，不可公网裸奔
EXEC_TIMEOUT_MS=600000       # 用户终端单命令硬超时（毫秒；agent bash 自检另受工具 schema ≤30s 约束）
EXEC_OUTPUT_MAX_BYTES=262144 # 单次执行累积输出上限（按字符近似；超限保尾丢头并前置截断标记）
EXEC_WORKSPACES_DIR=data/workspaces # 工作区物化根目录（相对进程 cwd，与 DB_FILE 同一现状）
